<Window x:Class="Sort.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorting Visualizer" Height="640" Width="1100" MinHeight="300" MinWidth="700">
    <Window.Resources>
        <DataTemplate x:Key="AlgoTip">
            <StackPanel MaxWidth="360">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                <TextBlock Text="{Binding Complexity}" TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="8,8,8,0">
            <ComboBox x:Name="AlgoBox" Width="130" Margin="0,0,12,0" VerticalAlignment="Center"
                      SelectionChanged="AlgoBox_SelectionChanged">
                <ComboBox.ToolTip>
                    <ToolTip Content="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}"
                             ContentTemplate="{StaticResource AlgoTip}"/>
                </ComboBox.ToolTip>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="2,1" ToolTipService.InitialShowDelay="250">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding}" ContentTemplate="{StaticResource AlgoTip}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider x:Name="SizeSlider" Width="150" Minimum="1" Maximum="6" Value="2" SmallChange="0.05" LargeChange="0.5"
                    VerticalAlignment="Center" ValueChanged="SizeSlider_ValueChanged"
                    ToolTip="Number of items (logarithmic, 10 to 1,000,000)"/>
            <TextBlock x:Name="SizeText" Width="70" Margin="4,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider x:Name="SpeedSlider" Width="130" Minimum="0" Maximum="120" Value="30"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="Operations shown per frame (exponential)"/>
            <CheckBox x:Name="SoundCheck" Content="Sound" IsChecked="True" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="1" Value="0.25"
                    VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="VolumeSlider_ValueChanged"
                    ToolTip="Volume"/>
            <Button x:Name="ShuffleButton" Content="Shuffle" Width="64" Margin="0,0,6,0" Click="Shuffle_Click"/>
            <Button x:Name="SortButton" Content="Sort" Width="64" Margin="0,0,6,0" Click="Sort_Click"/>
            <Button x:Name="PauseButton" Content="Pause" Width="64" Margin="0,0,6,0" Click="Pause_Click" IsEnabled="False"/>
            <Button x:Name="StepButton" Content="Step" Width="64" Margin="0,0,6,0" Click="Step_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="Stop" Width="64" Click="Stop_Click" IsEnabled="False"/>
        </WrapPanel>

        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="8,6,8,6" TextWrapping="Wrap" Foreground="Gray"/>

        <Border Grid.Row="2" Background="#FF1E1E1E" Margin="8,0">
            <Grid x:Name="BarHost" SizeChanged="BarHost_SizeChanged" ClipToBounds="True">
                <Image x:Name="BarImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="8" />
    </Grid>
</Window>
